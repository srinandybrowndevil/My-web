# ============================================
# MUCO LABS ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit .env file to version control
# Run: cp .env.example .env

# ============================================
# AI & API KEYS
# ============================================

# GEMINI_API_KEY: Required for Gemini AI API calls
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# APP_URL: The URL where this app is hosted
# Used for self-referential links, OAuth callbacks, and API endpoints
# Development: http://localhost:3000
# Production: https://mucolabs.com
APP_URL="http://localhost:3000"

# NODE_ENV: Environment mode (development | production)
NODE_ENV="development"

# ============================================
# EMAIL SERVICE CONFIGURATION (Resend)
# ============================================

# RESEND_API_KEY: Your Resend API key for email sending
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="your_resend_api_key_here"

# RESEND_FROM_EMAIL: Sender email address (must be verified in Resend)
RESEND_FROM_EMAIL="MUCO Labs <onboarding@resend.dev>"

# RESEND_TO_EMAIL: Destination email for receiving contact form submissions
RESEND_TO_EMAIL="contact@mucolabs.com"

# ============================================
# FIREBASE CONFIGURATION
# ============================================

# Firebase configuration will be loaded from firebase-applet-config.json
# These environment variables provide fallback values if needed
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""

# ============================================
# GOOGLE SERVICES INTEGRATION
# ============================================

# Google Apps Script / Sheets Endpoint for automatic lead logging
VITE_GOOGLE_SHEETS_ENDPOINT=""
VITE_GOOGLE_SCRIPT_URL=""

# ============================================
# SEO & ANALYTICS (Production Only)
# ============================================

# Google Search Console verification token
# Get from https://search.google.com/search-console
VITE_GOOGLE_SEARCH_CONSOLE_VERIFICATION=""

# Bing Webmaster Tools verification token
# Get from https://www.bing.com/webmasters
VITE_BING_WEBMASTER_VERIFICATION=""

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Get from https://analytics.google.com
VITE_GA4_MEASUREMENT_ID=""

# ============================================
# SECURITY & PERFORMANCE
# ============================================

# Enable/disable HMR in development (set to 'true' when using AI agents)
DISABLE_HMR="false"

# API rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE="60"

# Session secret for express sessions (generate a random string)
SESSION_SECRET="your_random_session_secret_here_generate_with_openssl_rand_base64_32"

